{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/praxis/branding/fastfetch/praxis.txt",
        "color": {
            "1": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 1
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 12,
            "color": {
                "index": 6
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "key": "",
            "format": "Praxis"
        },
        {
            "type": "custom",
            "key": "",
            "format": "Shell-first. Clear. Yours to shape."
        },
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        "separator",
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "Memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "Disk (/)",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}%)"
        },
        "separator",
        {
            "type": "locale",
            "key": "Locale"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
