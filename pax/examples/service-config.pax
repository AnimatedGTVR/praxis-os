[.Praxis Config - service config v2 .praxis.pax./]

# Enable workstation services explicitly.

let Service network = "NetworkManager"
let Service ssh = "sshd"
let Service trim = "fstrim.timer"
let Service time_sync = "systemd-timesyncd"

service enable network
assert state.service.last_enable == network "NetworkManager was not enabled"

service enable ssh
assert state.service.last_enable == ssh "sshd was not enabled"

service enable trim
assert state.service.last_enable == trim "fstrim timer was not enabled"

service enable time_sync
assert state.service.last_enable == time_sync "time sync was not enabled"

log "Service configuration complete."
