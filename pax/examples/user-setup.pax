[.Praxis Config - user setup v2 .praxis.pax./]

# User and group setup in PAX v2 action form.

let String primary_user = "alice"
let String secondary_user = "bob"

user create primary_user
assert state.user.last_create == primary_user "primary user was not created"

user add-group primary_user "wheel"
assert state.user.last_group == "wheel" "wheel group was not added"

user add-group primary_user "audio"
assert state.user.last_group == "audio" "audio group was not added"

user add-group primary_user "video"
assert state.user.last_group == "video" "video group was not added"

user set-password primary_user
assert state.user.last_password == primary_user "primary user password was not set"

user create secondary_user
assert state.user.last_create == secondary_user "secondary user was not created"

user add-group secondary_user "audio"
assert state.user.last_group == "audio" "secondary audio group was not added"

user add-group secondary_user "video"
assert state.user.last_group == "video" "secondary video group was not added"

user set-password secondary_user
assert state.user.last_password == secondary_user "secondary user password was not set"

set password for "root"
assert state.user.last_password == "root" "root password was not set"

log "User setup complete."
