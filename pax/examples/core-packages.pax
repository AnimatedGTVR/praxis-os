[.Praxis Config - core packages v2 .praxis.pax./]

# Core package profile for a standard Praxis workstation.
# PAX v2 package IDs are introduced with `pkg` and then installed by name.

let List<Package> core_packages = [
    pkg dev.praxis.linux,
    pkg dev.praxis.busybox,
    pkg org.mozilla.firefox,
    pkg dev.praxis.kitty,
    pkg dev.praxis.neovim,
    pkg org.videolan.vlc,
    pkg org.gnome.file_roller
]

for pkg in core_packages {
    install package pkg
    assert state.package.last_install == pkg "core package install did not land"
}

log "Core package profile applied."
