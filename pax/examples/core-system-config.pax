[.Praxis Config - core system config v2 .praxis.pax./]

# Base Praxis system intent without hidden config blocks.

let Package base_devel = pkg dev.praxis.base_devel
let Bundle essentials = bundle "essentials"
let Desktop desktop = xfce

check hardware
assert state.hardware.status == good "hardware gate failed"

install bundle essentials
assert state.package.last_bundle == essentials "essentials bundle did not install"

install package base_devel
assert state.package.last_install == base_devel "base-devel package did not install"

install desktop desktop
assert state.desktop.current == desktop "desktop did not install"

log "Core Praxis system config applied."
