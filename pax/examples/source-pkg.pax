[.Praxis Config - source package v2 .praxis.pax./]

# Source package workflow expressed as explicit package identity plus command.

let Package source_package = pkg dev.praxis.mesa_git
let Command build_command = "praxis-pkg build-source dev.praxis.mesa-git"

install package source_package
assert state.package.last_install == source_package "source package metadata did not install"

exec command build_command
assert state.exec.code == 0 "source build command failed"

log "Source package workflow complete."
