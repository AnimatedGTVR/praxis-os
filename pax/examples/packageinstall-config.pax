[.Praxis Config - package install v2 .praxis.pax./]

# Minimal PAX v2 package install example.

let Package desktop_package = pkg dev.praxis.xfce4
let Desktop desktop = xfce

check hardware
assert state.hardware.status == good "hardware gate failed"

install package desktop_package
assert state.package.last_install == desktop_package "desktop package install did not land"

install desktop desktop
assert state.desktop.current == desktop "desktop did not install"

log "Package install profile applied."
