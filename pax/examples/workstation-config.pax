[.Praxis Config - workstation profile v2 .praxis.pax./]

# A workstation profile in PAX v2 form.
# Declarations are not needed here because this profile only installs packages
# and a desktop.

let Desktop desktop = plasma
let List<Package> workstation_packages = [
    pkg org.mozilla.firefox,
    pkg dev.praxis.neovim,
    pkg org.videolan.vlc,
    pkg dev.praxis.kitty
]

for pkg in workstation_packages {
    install package pkg
    assert state.package.last_install == pkg "workstation package install did not land"
}

install desktop desktop
assert state.desktop.current == desktop "desktop did not install"

log "Workstation profile applied."
