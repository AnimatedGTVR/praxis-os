[.Praxis Config - full workstation install v2 sketch .praxis.pax./]

# PAX v2 sketch.
# This file is design syntax, not yet accepted by the v1 interpreter.
# Declarations bind names. Actions touch the machine. Assertions prove results.

const Path TARGET = "/mnt/praxis"
const Path BOOT   = "/mnt/praxis/boot"

const String HOSTNAME = "praxisbox"
const String LOCALE   = "en_US.UTF-8"
const String TIMEZONE = "America/New_York"
const String USER     = "alice"

input praxis-core from git "https://git.praxis.dev/core.git" at "v2.0.0"

declare Disk main {
    device = "/dev/vda"
    table = gpt
}

declare Partition boot {
    disk = disk.main
    number = 1
    start = "1MiB"
    end = "513MiB"
    type = efi-system
}

declare Partition root {
    disk = disk.main
    number = 2
    start = "513MiB"
    end = "100%"
    type = linux-filesystem
}

let List<Package> workstation_packages = [
    pkg org.mozilla.firefox,
    pkg dev.praxis.neovim,
    pkg dev.praxis.kitty,
]

let Bundle essentials = bundle "essentials"
let Bundle developer  = bundle "developer"

check hardware
assert state.hardware.status == good "hardware gate failed"
assert state.hardware.arch == x86_64 "unsupported architecture"

write gpt to disk.main
assert state.disk.last_table == disk.main "gpt table was not written"

create partition.boot
assert state.disk.last_partition == partition.boot "boot partition was not created"

create partition.root
assert state.disk.last_partition == partition.root "root partition was not created"

commit partition table disk.main
assert state.disk.table_committed == true "partition table was not committed"

format partition.boot as vfat
assert state.disk.last_format == partition.boot "boot format did not complete"

format partition.root as ext4
assert state.disk.last_format == partition.root "root format did not complete"

mkdir TARGET
assert state.file.last_mkdir == TARGET "target directory was not created"

mkdir BOOT
assert state.file.last_mkdir == BOOT "boot directory was not created"

mount partition.root at TARGET
assert state.mount.TARGET == mounted "root partition is not mounted"

mount partition.boot at BOOT
assert state.mount.BOOT == mounted "boot partition is not mounted"

install bundle essentials
assert state.package.last_bundle == essentials "essentials bundle did not install"

install bundle developer
assert state.package.last_bundle == developer "developer bundle did not install"

install desktop plasma
assert state.desktop.current == plasma "plasma desktop did not install"

for pkg in workstation_packages {
    install package pkg
    assert state.package.last_install == pkg "package install did not land"
}

set hostname HOSTNAME
assert state.system.hostname == HOSTNAME "hostname was not set"

set locale LOCALE
assert state.system.locale == LOCALE "locale was not set"

set timezone TIMEZONE
assert state.system.timezone == TIMEZONE "timezone was not set"

set keymap "us"
assert state.system.keymap == "us" "keymap was not set"

write file "/mnt/praxis/etc/locale.conf" content "LANG={LOCALE}\n"
assert state.file.last_write == "/mnt/praxis/etc/locale.conf" "locale.conf was not written"

exec command "locale-gen"
assert state.exec.code == 0 "locale generation failed"

user create USER
assert state.user.last_create == USER "user was not created"

user add-group USER "wheel"
assert state.user.last_group == "wheel" "wheel group was not added"

user add-group USER "audio"
assert state.user.last_group == "audio" "audio group was not added"

user add-group USER "video"
assert state.user.last_group == "video" "video group was not added"

user set-password USER
assert state.user.last_password == USER "user password was not set"

set password for "root"
assert state.user.last_password == "root" "root password was not set"

service enable "NetworkManager"
assert state.service.last_enable == "NetworkManager" "NetworkManager was not enabled"

service enable "sshd"
assert state.service.last_enable == "sshd" "sshd was not enabled"

initramfs build TARGET
assert state.initramfs.status == built "initramfs did not build"

bootloader install limine
assert state.bootloader.status == installed "bootloader did not install"

bootloader entry "praxis" {
    title = "Praxis"
    linux = "/praxis/vmlinuz"
    initrd = "/praxis/initramfs.cpio.gz"
    options = "root=UUID=auto rdinit=/init praxis.live=0 loglevel=3"
}
assert state.bootloader.last_entry == "praxis" "boot entry was not written"

umount BOOT
assert state.mount.BOOT == unmounted "boot partition is still mounted"

umount TARGET
assert state.mount.TARGET == unmounted "root partition is still mounted"

log "Install complete."
