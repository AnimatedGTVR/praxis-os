[.Praxis Config - disk setup v2 .praxis.pax./]

# Explicit disk layout for a Praxis install.
# Declarations describe the target. Actions perform the work.

const Path TARGET = "/mnt/praxis"
const Path BOOT = "/mnt/praxis/boot"

declare Disk main {
    device = "/dev/vda"
    table = gpt
}

declare Partition boot {
    disk = disk.main
    number = 1
    start = "1MiB"
    end = "513MiB"
    type = efi-system
}

declare Partition root {
    disk = disk.main
    number = 2
    start = "513MiB"
    end = "100%"
    type = linux-filesystem
}

check hardware
assert state.hardware.status == good "hardware gate failed"

write gpt to disk.main
assert state.disk.last_table == disk.main "gpt table was not written"

create partition.boot
assert state.disk.last_partition == partition.boot "boot partition was not created"

create partition.root
assert state.disk.last_partition == partition.root "root partition was not created"

commit partition table disk.main
assert state.disk.table_committed == true "partition table was not committed"

format partition.boot as vfat
assert state.disk.last_format == partition.boot "boot format did not complete"

format partition.root as ext4
assert state.disk.last_format == partition.root "root format did not complete"

mkdir TARGET
assert state.file.last_mkdir == TARGET "target directory was not created"

mkdir BOOT
assert state.file.last_mkdir == BOOT "boot directory was not created"

mount partition.root at TARGET
assert state.mount.TARGET == mounted "root partition is not mounted"

mount partition.boot at BOOT
assert state.mount.BOOT == mounted "boot partition is not mounted"

log "Disk mounted."
