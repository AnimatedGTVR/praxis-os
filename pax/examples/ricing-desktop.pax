[.Praxis Config - ricing desktop v2 .praxis.pax./]

# Desktop theming support packages in PAX v2 form.

let Desktop desktop = plasma
let List<Package> ricing_packages = [
    pkg dev.praxis.picom,
    pkg dev.praxis.rofi,
    pkg dev.praxis.polybar,
    pkg dev.praxis.kitty
]

for pkg in ricing_packages {
    install package pkg
    assert state.package.last_install == pkg "ricing package install did not land"
}

install desktop desktop
assert state.desktop.current == desktop "desktop did not install"

log "Ricing desktop profile applied."
