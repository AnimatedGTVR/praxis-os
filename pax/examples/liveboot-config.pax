[.Praxis Config - liveboot config v2 .praxis.pax./]

# Live boot policy in PAX v2 form.

let Desktop live_desktop = gnome
let Service display_manager = "gdm"

check hardware
assert state.hardware.status == good "live boot hardware gate failed"

install desktop live_desktop
assert state.desktop.current == live_desktop "live desktop did not install"

service enable display_manager
assert state.service.last_enable == display_manager "display manager was not enabled"

log "Live boot desktop path is ready."
