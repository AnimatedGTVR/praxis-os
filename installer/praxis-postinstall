#!/bin/sh

set -eu

case "$0" in
    */*)
        SCRIPT_DIR_PATH="${0%/*}"
        ;;
    *)
        SCRIPT_DIR_PATH="."
        ;;
esac

SCRIPT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR_PATH}" && pwd)"

if [ -n "${PRAXIS_LIB_ROOT:-}" ] && [ -r "${PRAXIS_LIB_ROOT}/common.sh" ]; then
    . "${PRAXIS_LIB_ROOT}/common.sh"
elif [ -r /usr/local/lib/praxis/common.sh ]; then
    . /usr/local/lib/praxis/common.sh
else
    . "${SCRIPT_DIR}/lib/common.sh"
fi

TARGET_ROOT="${1:-}"
[ -n "${TARGET_ROOT}" ] || { printf 'usage: praxis-postinstall <target>\n' >&2; exit 1; }

STAGE_FILE="${TARGET_ROOT}/etc/praxis/install-stage"
stage=""
if [ -r "${STAGE_FILE}" ]; then
    stage="$(head -n1 "${STAGE_FILE}" 2>/dev/null || true)"
fi

ok()   { printf '[ok]   %s\n' "$1"; }
fix()  { printf '[fix]  %s\n' "$1"; }
miss() { printf '[miss] %s\n' "$1"; }

printf 'Praxis :: Post-install check\n\n'

# ── Stage ─────────────────────────────────────────────────────────────────────

if [ -n "${stage}" ]; then
    ok "install-stage: ${stage}"
else
    miss "install-stage: none — run praxis-install first"
fi

# ── Hostname ──────────────────────────────────────────────────────────────────

if [ -r "${TARGET_ROOT}/etc/hostname" ]; then
    ok "hostname: $(head -n1 "${TARGET_ROOT}/etc/hostname")"
else
    miss "hostname: missing"
fi

# ── fstab ─────────────────────────────────────────────────────────────────────

if [ -r "${TARGET_ROOT}/etc/fstab" ]; then
    ok "fstab: present"
elif [ "${PRAXIS_ALLOW_UNMOUNTED_TARGET:-0}" != "1" ] && praxis_is_mountpoint "${TARGET_ROOT}" 2>/dev/null; then
    fix "fstab: generating"
    praxis_write_fstab "${TARGET_ROOT}"
else
    miss "fstab: missing — mount target and run praxis-install"
fi

# ── Machine ID ────────────────────────────────────────────────────────────────

if [ -r "${TARGET_ROOT}/etc/machine-id" ] && \
   grep -Eq '^[0-9a-f]{32}$' "${TARGET_ROOT}/etc/machine-id" 2>/dev/null; then
    ok "machine-id: present"
else
    fix "machine-id: generating"
    od -A n -t x1 /dev/urandom 2>/dev/null | tr -d ' \n' | head -c 32 \
        > "${TARGET_ROOT}/etc/machine-id" 2>/dev/null || \
        printf '%032x\n' 0 > "${TARGET_ROOT}/etc/machine-id"
fi

# ── Locale ────────────────────────────────────────────────────────────────────

if [ -f "${TARGET_ROOT}/etc/locale.conf" ]; then
    ok "locale.conf: present"
else
    fix "locale.conf: writing default (en_US.UTF-8)"
    printf 'LANG=en_US.UTF-8\n' > "${TARGET_ROOT}/etc/locale.conf"
fi

# ── Timezone ──────────────────────────────────────────────────────────────────

if [ -e "${TARGET_ROOT}/etc/localtime" ]; then
    ok "localtime: present"
else
    fix "localtime: symlinking to UTC"
    ln -sf /usr/share/zoneinfo/UTC "${TARGET_ROOT}/etc/localtime"
fi

# ── initramfs policy ──────────────────────────────────────────────────────────

if [ -f "${TARGET_ROOT}/etc/praxis/initramfs.conf" ]; then
    ok "initramfs.conf: present"
else
    fix "initramfs.conf: writing default policy"
    mkdir -p "${TARGET_ROOT}/etc/praxis"
    cat > "${TARGET_ROOT}/etc/praxis/initramfs.conf" <<'EOF'
INITRAMFS_FORMAT=newc
INITRAMFS_COMPRESSION=gzip
INITRAMFS_OWNER=manual
EOF
fi

# ── Kernel / initramfs ────────────────────────────────────────────────────────

if [ -f "${TARGET_ROOT}/boot/praxis/vmlinuz" ]; then
    ok "vmlinuz: present"
else
    miss "vmlinuz: missing — run mkinitrd"
fi

if [ -f "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz" ]; then
    ok "initramfs: present"
else
    miss "initramfs: missing — run mkinitrd"
fi

# ── Bootloader ────────────────────────────────────────────────────────────────

if [ -f "${TARGET_ROOT}/boot/limine.conf" ]; then
    ok "limine.conf: present"
else
    miss "limine.conf: missing"
fi

if [ -f "${TARGET_ROOT}/boot/EFI/BOOT/BOOTX64.EFI" ]; then
    ok "BOOTX64.EFI: present"
else
    miss "BOOTX64.EFI: missing"
fi

if [ -f "${TARGET_ROOT}/boot/loader/entries/praxis.conf" ]; then
    ok "systemd-boot entry: present"
else
    miss "systemd-boot entry: missing"
fi

printf '\n'
