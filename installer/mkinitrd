#!/bin/sh

set -eu

case "$0" in
    */*)
        SCRIPT_DIR="$(CDPATH= cd -- "${0%/*}" && pwd)"
        ;;
    *)
        SCRIPT_DIR="."
        ;;
esac

if [ -n "${PRAXIS_LIB_ROOT:-}" ] && [ -r "${PRAXIS_LIB_ROOT}/common.sh" ]; then
    . "${PRAXIS_LIB_ROOT}/common.sh"
elif [ -r /usr/local/lib/praxis/common.sh ]; then
    . /usr/local/lib/praxis/common.sh
else
    . "${SCRIPT_DIR}/lib/common.sh"
fi

TARGET_ROOT="${1:-}"

[ -n "${TARGET_ROOT}" ] || { printf 'usage: mkinitrd <target>\n' >&2; exit 1; }

STAGE_FILE="${TARGET_ROOT}/etc/praxis/install-stage"
[ -r "${STAGE_FILE}" ] || { printf 'no stage: run praxis-install first\n' >&2; exit 1; }

stage="$(head -n1 "${STAGE_FILE}" 2>/dev/null || true)"
[ "${stage}" = "rootfs" ] || { printf 'wrong stage: %s\n' "${stage:-none}" >&2; exit 1; }

FSTAB_FILE="${TARGET_ROOT}/etc/fstab"
[ -r "${FSTAB_FILE}" ] || { printf 'missing fstab\n' >&2; exit 1; }
INITRAMFS_CONF="${TARGET_ROOT}/etc/praxis/initramfs.conf"
[ -r "${INITRAMFS_CONF}" ] || { printf 'missing initramfs policy: %s\n' "${INITRAMFS_CONF}" >&2; exit 1; }

grep -Eq '^INITRAMFS_FORMAT=newc$' "${INITRAMFS_CONF}" || {
    printf 'initramfs policy must set INITRAMFS_FORMAT=newc\n' >&2
    exit 1
}

grep -Eq '^INITRAMFS_COMPRESSION=gzip$' "${INITRAMFS_CONF}" || {
    printf 'initramfs policy must set INITRAMFS_COMPRESSION=gzip\n' >&2
    exit 1
}

grep -Eq '^INITRAMFS_OWNER=manual$' "${INITRAMFS_CONF}" || {
    printf 'initramfs policy must set INITRAMFS_OWNER=manual\n' >&2
    exit 1
}

if ! grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/[[:space:]]+' "${FSTAB_FILE}"; then
    printf 'fstab must mount / by UUID\n' >&2
    exit 1
fi

if ! grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/boot[[:space:]]+' "${FSTAB_FILE}"; then
    printf 'fstab must mount /boot by UUID\n' >&2
    exit 1
fi

if [ "${PRAXIS_ALLOW_UNMOUNTED_TARGET:-0}" != "1" ]; then
    praxis_is_mountpoint "${TARGET_ROOT}" || { printf 'not mounted: %s\n' "${TARGET_ROOT}" >&2; exit 1; }
fi

SOURCE_ROOT="${PRAXIS_SOURCE_ROOT:-/}"
KERNEL_SOURCE="${PRAXIS_INSTALL_KERNEL:-$SOURCE_ROOT/usr/share/praxis/vmlinuz}"
INITRAMFS_ROOT="$(sed -n 's/^INITRAMFS_ROOT=//p' "${INITRAMFS_CONF}" | sed -n '1p')"
[ -n "${INITRAMFS_ROOT}" ] || INITRAMFS_ROOT="target"
case "${INITRAMFS_ROOT}" in
    target)
        INITRAMFS_SOURCE_ROOT="${TARGET_ROOT}"
        ;;
    disk)
        INITRAMFS_SOURCE_ROOT="${SOURCE_ROOT}"
        ;;
    *)
        printf 'unsupported INITRAMFS_ROOT: %s\n' "${INITRAMFS_ROOT}" >&2
        exit 1
        ;;
esac

[ -f "${KERNEL_SOURCE}" ] || { printf 'missing kernel: %s\n' "${KERNEL_SOURCE}" >&2; exit 1; }
command -v gzip >/dev/null 2>&1 || { printf 'missing: gzip\n' >&2; exit 1; }

if ! command -v bsdtar >/dev/null 2>&1 && ! command -v cpio >/dev/null 2>&1; then
    printf 'missing: cpio\n' >&2; exit 1
fi

mkdir -p "${TARGET_ROOT}/boot/praxis"
cp "${KERNEL_SOURCE}" "${TARGET_ROOT}/boot/praxis/vmlinuz"

# The exclude paths below must be relative to INITRAMFS_SOURCE_ROOT, which is
# NOT always TARGET_ROOT (INITRAMFS_ROOT=disk builds from SOURCE_ROOT, e.g.
# "/" on a live install, while TARGET_ROOT is the mounted install target,
# e.g. "/mnt/praxis"). A hardcoded "./boot" exclude only ever protected the
# output archive when INITRAMFS_SOURCE_ROOT and TARGET_ROOT were the same
# path -- in the real disk-mode install case they are not, so the archive
# recursed into its own growing output file with nothing to stop it.
case "${TARGET_ROOT}" in
    "${INITRAMFS_SOURCE_ROOT}"/*)
        TARGET_REL="${TARGET_ROOT#"${INITRAMFS_SOURCE_ROOT}"/}"
        TARGET_EXCLUDE="./${TARGET_REL}/boot"
        ARCHIVE_EXCLUDE="./${TARGET_REL}/boot/praxis/initramfs.cpio.gz"
        ;;
    "${INITRAMFS_SOURCE_ROOT}")
        TARGET_EXCLUDE="./boot"
        ARCHIVE_EXCLUDE="./boot/praxis/initramfs.cpio.gz"
        ;;
    *)
        # TARGET_ROOT is not inside INITRAMFS_SOURCE_ROOT at all (e.g. a
        # bind mount elsewhere); nothing under INITRAMFS_SOURCE_ROOT can
        # be the growing output file, so there is nothing to exclude.
        TARGET_EXCLUDE=""
        ARCHIVE_EXCLUDE=""
        ;;
esac

if command -v bsdtar >/dev/null 2>&1; then
    bsdtar_exclude_args=""
    [ -z "${TARGET_EXCLUDE}" ] || bsdtar_exclude_args="--exclude ${TARGET_EXCLUDE} --exclude ${ARCHIVE_EXCLUDE}"
    # shellcheck disable=SC2086
    bsdtar -C "${INITRAMFS_SOURCE_ROOT}" \
        --format=newc \
        --exclude "./proc" --exclude "./sys" --exclude "./dev" \
        --exclude "./run" --exclude "./tmp" \
        ${bsdtar_exclude_args} \
        -cf - . | gzip -n -9 > "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz"
else
    (
        cd "${INITRAMFS_SOURCE_ROOT}"
        if [ -n "${TARGET_EXCLUDE}" ]; then
            find . \
                \( -path ./proc -o -path './proc/*' \
                -o -path ./sys -o -path './sys/*' \
                -o -path ./dev -o -path './dev/*' \
                -o -path ./run -o -path './run/*' \
                -o -path ./tmp -o -path './tmp/*' \
                -o -path "${TARGET_EXCLUDE}" -o -path "${TARGET_EXCLUDE}/*" \
                -o -path "${ARCHIVE_EXCLUDE}" \) -prune \
                -o -print | cpio -o -H newc | gzip -n -9
        else
            find . \
                \( -path ./proc -o -path './proc/*' \
                -o -path ./sys -o -path './sys/*' \
                -o -path ./dev -o -path './dev/*' \
                -o -path ./run -o -path './run/*' \
                -o -path ./tmp -o -path './tmp/*' \) -prune \
                -o -print | cpio -o -H newc | gzip -n -9
        fi
    ) > "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz"
fi

printf 'initrd\n' > "${TARGET_ROOT}/etc/praxis/install-stage"
sync
printf 'initrd (%s root) -> %s/boot/praxis/\n' "${INITRAMFS_ROOT}" "${TARGET_ROOT}"
