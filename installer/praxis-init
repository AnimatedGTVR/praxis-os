#!/bin/sh

set -eu

case "$0" in
    */*)
        SCRIPT_DIR_PATH="${0%/*}"
        ;;
    *)
        SCRIPT_DIR_PATH="."
        ;;
esac

SCRIPT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR_PATH}" && pwd)"

if [ -n "${PRAXIS_LIB_ROOT:-}" ] && [ -r "${PRAXIS_LIB_ROOT}/common.sh" ]; then
    . "${PRAXIS_LIB_ROOT}/common.sh"
elif [ -r /usr/local/lib/praxis/common.sh ]; then
    . /usr/local/lib/praxis/common.sh
else
    . "${SCRIPT_DIR}/lib/common.sh"
fi

DISKS_ENV="$(praxis_config_root)/disks.env"

praxis_header "Init"

if ! command -v blkid >/dev/null 2>&1; then
    printf 'blkid not found\n' >&2
    exit 1
fi

mkdir -p "$(praxis_config_root)"

{
    printf '# Generated by praxis-init\n'
    blkid -o export 2>/dev/null | awk '
        /^DEVNAME=/ {
            dev = $0
            sub(/^DEVNAME=/, "", dev)
            key = dev
            gsub(/[^A-Za-z0-9]/, "_", key)
            sub(/^_+/, "", key)
            next
        }
        /^[A-Z_]+=/ && key != "" {
            name = $0
            sub(/=.*/, "", name)
            val  = $0
            sub(/^[^=]*=/, "", val)
            printf "PRAXIS_DISK_%s_%s=%s\n", key, name, val
        }
        /^$/ { key = "" }
    '
} > "${DISKS_ENV}"

printf 'Block devices:\n\n'
blkid 2>/dev/null || true
printf '\nWrote %s\n' "${DISKS_ENV}"
