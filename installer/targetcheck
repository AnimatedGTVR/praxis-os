#!/bin/sh

set -eu

case "$0" in
    */*)
        SCRIPT_DIR_PATH="${0%/*}"
        ;;
    *)
        SCRIPT_DIR_PATH="."
        ;;
esac

SCRIPT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR_PATH}" && pwd)"

if [ -n "${PRAXIS_LIB_ROOT:-}" ] && [ -r "${PRAXIS_LIB_ROOT}/common.sh" ]; then
    . "${PRAXIS_LIB_ROOT}/common.sh"
elif [ -r /usr/local/lib/praxis/common.sh ]; then
    . /usr/local/lib/praxis/common.sh
else
    . "${SCRIPT_DIR}/lib/common.sh"
fi

STRICT_MODE=0
TARGET_ROOT=""

usage() {
    printf '%s\n' "usage: targetcheck [--strict] <target-root>"
    printf '%s\n' "example: targetcheck /mnt/praxis"
    printf '%s\n' "example: targetcheck --strict /mnt/praxis"
}

print_field() {
    printf '%-18s %s\n' "$1" "$2"
}

read_meta_value() {
    META_FILE="$1"
    META_KEY="$2"

    if [ ! -r "${META_FILE}" ]; then
        return 1
    fi

    sed -n "s/^${META_KEY}=//p" "${META_FILE}" | sed -n '1p'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --strict)
            STRICT_MODE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            exit 1
            ;;
        *)
            [ -z "${TARGET_ROOT}" ] || { usage >&2; exit 1; }
            TARGET_ROOT="$1"
            shift
            ;;
    esac
done

if [ -z "${TARGET_ROOT}" ]; then
    usage >&2
    exit 1
fi

if [ ! -d "${TARGET_ROOT}" ]; then
    printf 'missing target root: %s\n' "${TARGET_ROOT}" >&2
    exit 1
fi

ROOT_MOUNTED="no"
BOOT_MOUNTED="no"
ROOT_FSTYPE="unknown"
BOOT_FSTYPE="unknown"
ESP_STATUS="unknown"
INSTALL_MODE="missing"
INSTALL_ENTRY="unknown"
SYSTEMD_BOOT_ENTRY="unknown"
SYSTEMD_BOOT_INSTALLED="unknown"
LIMINE_CONFIG="unknown"
LIMINE_UEFI="unknown"
INSTALL_COMPLETE="unknown"
INSTALL_STAGE="none"
TARGET_HOSTNAME="unknown"
INSTALL_DESKTOP="none"
INSTALL_BUNDLES="none"
INSTALL_PACKAGES="none"
CHOICE_FILE="${TARGET_ROOT}/etc/praxis/system.choice"
CHOICE_STATUS="missing"
CHOICE_KERNEL="unknown"
CHOICE_ARTIFACT="unknown"
CHOICE_FRAGMENT="unknown"
CHOICE_INIT="unknown"
CHOICE_RDINIT="unknown"
CHOICE_INIT_FILES="unknown"
CHOICE_INIT_DIRS="unknown"
CHOICE_DESKTOP="none"
CHOICE_BUNDLES="none"
CHOICE_PACKAGES="none"
CHOICE_VALIDATION="unknown"
PACKAGES_SELECTED_FILE="${TARGET_ROOT}/etc/praxis/packages.selected"
SELECTED_DESKTOP="unknown"
SELECTED_BUNDLES="unknown"
SELECTED_EXTRA="unknown"
SELECTED_INSTALLED="unknown"
HOSTS_STATUS="missing"
ENTRY_FILE=""
EXPECTED_ENTRY_FILE=""
LOADER_CONF_FILE="${TARGET_ROOT}/boot/loader/loader.conf"
LOADER_DEFAULT="unknown"
ENTRY_LINUX="unknown"
ENTRY_INITRD="unknown"
ENTRY_OPTIONS="unknown"
FSTAB_ROOT_UUID="unknown"
FSTAB_BOOT_UUID="unknown"
ENTRY_ROOT_UUID="unknown"
STATUS=0
WARNINGS=0
PARTIAL_INSTALL=0

if praxis_is_mountpoint "${TARGET_ROOT}"; then
    ROOT_MOUNTED="yes"
    ROOT_FSTYPE="$(praxis_find_mount_fstype "${TARGET_ROOT}" || true)"
fi

if praxis_is_mountpoint "${TARGET_ROOT}/boot"; then
    BOOT_MOUNTED="yes"
    BOOT_FSTYPE="$(praxis_find_mount_fstype "${TARGET_ROOT}/boot" || true)"
fi

[ -n "${ROOT_FSTYPE}" ] || ROOT_FSTYPE="unknown"
[ -n "${BOOT_FSTYPE}" ] || BOOT_FSTYPE="unknown"

case "${BOOT_FSTYPE}" in
    vfat|fat|fat32|msdos)
        ESP_STATUS="likely"
        ;;
    unknown)
        ESP_STATUS="unknown"
        ;;
    *)
        ESP_STATUS="unlikely"
        ;;
esac

for CANDIDATE in "${TARGET_ROOT}/boot/loader/entries/"*.conf; do
    if [ -f "${CANDIDATE}" ]; then
        ENTRY_FILE="${CANDIDATE}"
        break
    fi
done

if [ -r "${TARGET_ROOT}/etc/praxis/install-stage" ]; then
    INSTALL_STAGE="$(head -n1 "${TARGET_ROOT}/etc/praxis/install-stage" 2>/dev/null || true)"
    [ -n "${INSTALL_STAGE}" ] || INSTALL_STAGE="none"
fi

if [ -r "${TARGET_ROOT}/etc/praxis/install" ]; then
    INSTALL_MODE="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_MODE || true)"
    [ -n "${INSTALL_MODE}" ] || INSTALL_MODE="present"
    TARGET_HOSTNAME="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_HOSTNAME || true)"
    [ -n "${TARGET_HOSTNAME}" ] || TARGET_HOSTNAME="unknown"
    INSTALL_ENTRY="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_ENTRY || true)"
    [ -n "${INSTALL_ENTRY}" ] || INSTALL_ENTRY="unknown"
    INSTALL_DESKTOP="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_DESKTOP || true)"
    [ -n "${INSTALL_DESKTOP}" ] || INSTALL_DESKTOP="none"
    INSTALL_BUNDLES="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_BUNDLES || true)"
    [ -n "${INSTALL_BUNDLES}" ] || INSTALL_BUNDLES="none"
    INSTALL_PACKAGES="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_PACKAGES || true)"
    [ -n "${INSTALL_PACKAGES}" ] || INSTALL_PACKAGES="none"
    SYSTEMD_BOOT_ENTRY="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" SYSTEMD_BOOT_ENTRY || true)"
    [ -n "${SYSTEMD_BOOT_ENTRY}" ] || SYSTEMD_BOOT_ENTRY="unknown"
    SYSTEMD_BOOT_INSTALLED="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" SYSTEMD_BOOT_INSTALLED || true)"
    [ -n "${SYSTEMD_BOOT_INSTALLED}" ] || SYSTEMD_BOOT_INSTALLED="unknown"
    LIMINE_CONFIG="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" LIMINE_CONFIG || true)"
    [ -n "${LIMINE_CONFIG}" ] || LIMINE_CONFIG="unknown"
    LIMINE_UEFI="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" LIMINE_UEFI || true)"
    [ -n "${LIMINE_UEFI}" ] || LIMINE_UEFI="unknown"
    INSTALL_COMPLETE="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_COMPLETE || true)"
    [ -n "${INSTALL_COMPLETE}" ] || INSTALL_COMPLETE="unknown"
fi

if [ -r "${CHOICE_FILE}" ]; then
    CHOICE_STATUS="present"
    CHOICE_KERNEL="$(read_meta_value "${CHOICE_FILE}" KERNEL_PROFILE || true)"
    [ -n "${CHOICE_KERNEL}" ] || CHOICE_KERNEL="missing"
    CHOICE_ARTIFACT="$(read_meta_value "${CHOICE_FILE}" KERNEL_ARTIFACT || true)"
    [ -n "${CHOICE_ARTIFACT}" ] || CHOICE_ARTIFACT="missing"
    CHOICE_FRAGMENT="$(read_meta_value "${CHOICE_FILE}" KERNEL_CONFIG_FRAGMENT || true)"
    [ -n "${CHOICE_FRAGMENT}" ] || CHOICE_FRAGMENT="missing"
    CHOICE_INIT="$(read_meta_value "${CHOICE_FILE}" INIT_CHOICE || true)"
    [ -n "${CHOICE_INIT}" ] || CHOICE_INIT="missing"
    CHOICE_RDINIT="$(read_meta_value "${CHOICE_FILE}" INIT_RDINIT || true)"
    [ -n "${CHOICE_RDINIT}" ] || CHOICE_RDINIT="missing"
    CHOICE_INIT_FILES="$(read_meta_value "${CHOICE_FILE}" INIT_REQUIRED_FILES || true)"
    [ -n "${CHOICE_INIT_FILES}" ] || CHOICE_INIT_FILES="missing"
    CHOICE_INIT_DIRS="$(read_meta_value "${CHOICE_FILE}" INIT_REQUIRED_DIRS || true)"
    [ -n "${CHOICE_INIT_DIRS}" ] || CHOICE_INIT_DIRS="missing"
    CHOICE_DESKTOP="$(read_meta_value "${CHOICE_FILE}" DESKTOP_PROFILE || true)"
    [ -n "${CHOICE_DESKTOP}" ] || CHOICE_DESKTOP="none"
    CHOICE_BUNDLES="$(read_meta_value "${CHOICE_FILE}" PACKAGE_BUNDLES || true)"
    [ -n "${CHOICE_BUNDLES}" ] || CHOICE_BUNDLES="none"
    CHOICE_PACKAGES="$(read_meta_value "${CHOICE_FILE}" EXTRA_PACKAGES || true)"
    [ -n "${CHOICE_PACKAGES}" ] || CHOICE_PACKAGES="none"
    if command -v praxis-choice >/dev/null 2>&1; then
        if PRAXIS_CONFIG_ROOT="${TARGET_ROOT}/etc/praxis" praxis-choice validate "${CHOICE_FILE}" >/dev/null 2>&1; then
            CHOICE_VALIDATION="valid"
        else
            CHOICE_VALIDATION="invalid"
        fi
    elif [ -x "${SCRIPT_DIR}/praxis-choice" ]; then
        if PRAXIS_CONFIG_ROOT="${TARGET_ROOT}/etc/praxis" "${SCRIPT_DIR}/praxis-choice" validate "${CHOICE_FILE}" >/dev/null 2>&1; then
            CHOICE_VALIDATION="valid"
        else
            CHOICE_VALIDATION="invalid"
        fi
    else
        CHOICE_VALIDATION="unchecked"
    fi
fi

if [ -r "${PACKAGES_SELECTED_FILE}" ]; then
    SELECTED_DESKTOP="$(read_meta_value "${PACKAGES_SELECTED_FILE}" DESKTOP || true)"
    [ -n "${SELECTED_DESKTOP}" ] || SELECTED_DESKTOP="unknown"
    SELECTED_BUNDLES="$(read_meta_value "${PACKAGES_SELECTED_FILE}" BUNDLES || true)"
    [ -n "${SELECTED_BUNDLES}" ] || SELECTED_BUNDLES="unknown"
    SELECTED_EXTRA="$(read_meta_value "${PACKAGES_SELECTED_FILE}" EXTRA || true)"
    [ -n "${SELECTED_EXTRA}" ] || SELECTED_EXTRA="unknown"
    SELECTED_INSTALLED="$(read_meta_value "${PACKAGES_SELECTED_FILE}" INSTALLED || true)"
    [ -n "${SELECTED_INSTALLED}" ] || SELECTED_INSTALLED="unknown"
fi

if [ ! -r "${TARGET_ROOT}/etc/praxis/install" ] && { [ -f "${TARGET_ROOT}/boot/praxis/vmlinuz" ] || [ -f "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz" ]; }; then
    PARTIAL_INSTALL=1
fi

if [ "${INSTALL_ENTRY}" != "unknown" ]; then
    EXPECTED_ENTRY_FILE="${TARGET_ROOT}/boot/loader/entries/${INSTALL_ENTRY}.conf"
    if [ -f "${EXPECTED_ENTRY_FILE}" ]; then
        ENTRY_FILE="${EXPECTED_ENTRY_FILE}"
    fi
fi

if [ -f "${LOADER_CONF_FILE}" ]; then
    LOADER_DEFAULT="$(sed -n 's/^default[[:space:]]\+//p' "${LOADER_CONF_FILE}" | sed -n '1p')"
    [ -n "${LOADER_DEFAULT}" ] || LOADER_DEFAULT="unknown"
fi

if [ -n "${ENTRY_FILE}" ] && [ -r "${ENTRY_FILE}" ]; then
    ENTRY_LINUX="$(sed -n 's/^linux[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_LINUX}" ] || ENTRY_LINUX="unknown"
    ENTRY_INITRD="$(sed -n 's/^initrd[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_INITRD}" ] || ENTRY_INITRD="unknown"
    ENTRY_OPTIONS="$(sed -n 's/^options[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_OPTIONS}" ] || ENTRY_OPTIONS="unknown"
fi

if [ -r "${TARGET_ROOT}/etc/fstab" ]; then
    FSTAB_ROOT_UUID="$(sed -n 's/^[[:space:]]*UUID=\([^[:space:]]*\)[[:space:]]\+\/[[:space:]].*/\1/p' "${TARGET_ROOT}/etc/fstab" | sed -n '1p')"
    [ -n "${FSTAB_ROOT_UUID}" ] || FSTAB_ROOT_UUID="unknown"
    FSTAB_BOOT_UUID="$(sed -n 's/^[[:space:]]*UUID=\([^[:space:]]*\)[[:space:]]\+\/boot[[:space:]].*/\1/p' "${TARGET_ROOT}/etc/fstab" | sed -n '1p')"
    [ -n "${FSTAB_BOOT_UUID}" ] || FSTAB_BOOT_UUID="unknown"
fi

case "${ENTRY_OPTIONS}" in
    *root=UUID=*)
        ENTRY_ROOT_UUID="$(printf '%s\n' "${ENTRY_OPTIONS}" | sed -n 's/.*root=UUID=\([^[:space:]]*\).*/\1/p')"
        [ -n "${ENTRY_ROOT_UUID}" ] || ENTRY_ROOT_UUID="unknown"
        ;;
esac

if [ "${TARGET_HOSTNAME}" = "unknown" ] && [ -r "${TARGET_ROOT}/etc/hostname" ]; then
    TARGET_HOSTNAME="$(sed -n '1p' "${TARGET_ROOT}/etc/hostname")"
    [ -n "${TARGET_HOSTNAME}" ] || TARGET_HOSTNAME="unknown"
fi

if [ -r "${TARGET_ROOT}/etc/hosts" ] && [ "${TARGET_HOSTNAME}" != "unknown" ]; then
    if grep -Eq "^127\\.0\\.1\\.1[[:space:]]+${TARGET_HOSTNAME}\$" "${TARGET_ROOT}/etc/hosts"; then
        HOSTS_STATUS="ok"
    else
        HOSTS_STATUS="present"
    fi
fi

praxis_header "targetcheck"
print_field "Target" "${TARGET_ROOT}"
print_field "Strict mode" "${STRICT_MODE}"
print_field "Root mounted" "${ROOT_MOUNTED}"
print_field "Boot mounted" "${BOOT_MOUNTED}"
print_field "Root fs" "${ROOT_FSTYPE}"
print_field "Boot fs" "${BOOT_FSTYPE}"
print_field "Boot is ESP" "${ESP_STATUS}"
print_field "Install mode" "${INSTALL_MODE}"
print_field "Install stage" "${INSTALL_STAGE}"
print_field "Hostname" "${TARGET_HOSTNAME}"
print_field "Install entry" "${INSTALL_ENTRY}"
print_field "Loader default" "${LOADER_DEFAULT}"
print_field "Bootctl entry" "${SYSTEMD_BOOT_ENTRY}"
print_field "Bootctl installed" "${SYSTEMD_BOOT_INSTALLED}"
print_field "Limine config" "${LIMINE_CONFIG}"
print_field "Limine UEFI" "${LIMINE_UEFI}"
print_field "Install complete" "${INSTALL_COMPLETE}"
print_field "System choice" "${CHOICE_STATUS}"
print_field "Choice kernel" "${CHOICE_KERNEL}"
print_field "Choice artifact" "${CHOICE_ARTIFACT}"
print_field "Choice fragment" "${CHOICE_FRAGMENT}"
print_field "Choice init" "${CHOICE_INIT}"
print_field "Choice rdinit" "${CHOICE_RDINIT}"
print_field "Choice init files" "${CHOICE_INIT_FILES}"
print_field "Choice init dirs" "${CHOICE_INIT_DIRS}"
print_field "Choice desktop" "${CHOICE_DESKTOP}"
print_field "Choice bundles" "${CHOICE_BUNDLES}"
print_field "Choice valid" "${CHOICE_VALIDATION}"

if [ -f "${TARGET_ROOT}/boot/praxis/vmlinuz" ]; then
    print_field "Kernel" "present"
else
    print_field "Kernel" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz" ]; then
    print_field "Initramfs" "present"
else
    print_field "Initramfs" "missing"
    STATUS=1
fi

if [ -n "${ENTRY_FILE}" ]; then
    print_field "Loader entry" "${ENTRY_FILE##*/}"
else
    print_field "Loader entry" "missing"
    STATUS=1
fi

if [ -f "${LOADER_CONF_FILE}" ]; then
    print_field "loader.conf" "present"
else
    print_field "loader.conf" "missing"
    STATUS=1
fi

if [ -n "${ENTRY_FILE}" ]; then
    ENTRY_NAME="${ENTRY_FILE##*/}"
    ENTRY_NAME="${ENTRY_NAME%.conf}"
    if [ "${LOADER_DEFAULT}" = "${ENTRY_NAME}" ]; then
        print_field "Default matches" "yes"
    else
        print_field "Default matches" "no: ${LOADER_DEFAULT}"
        STATUS=1
    fi
fi

if [ "${ENTRY_LINUX}" = "/praxis/vmlinuz" ]; then
    print_field "Entry linux" "${ENTRY_LINUX}"
elif [ -n "${ENTRY_FILE}" ]; then
    print_field "Entry linux" "${ENTRY_LINUX}"
    STATUS=1
fi

if [ "${ENTRY_INITRD}" = "/praxis/initramfs.cpio.gz" ]; then
    print_field "Entry initrd" "${ENTRY_INITRD}"
elif [ -n "${ENTRY_FILE}" ]; then
    print_field "Entry initrd" "${ENTRY_INITRD}"
    STATUS=1
fi

case "${ENTRY_OPTIONS}" in
    *"root=UUID="*) print_field "Entry root" "UUID" ;;
    *) print_field "Entry root" "missing root=UUID"; STATUS=1 ;;
esac

if [ "${FSTAB_ROOT_UUID}" != "unknown" ] && [ "${ENTRY_ROOT_UUID}" = "${FSTAB_ROOT_UUID}" ]; then
    print_field "Root UUID match" "yes"
else
    print_field "Root UUID match" "no"
    STATUS=1
fi

case "${ENTRY_OPTIONS}" in
    *"rdinit="*) print_field "Entry rdinit" "present" ;;
    *) print_field "Entry rdinit" "missing"; STATUS=1 ;;
esac

if [ "${CHOICE_STATUS}" = "present" ]; then
    if [ "${CHOICE_VALIDATION}" = "invalid" ]; then
        print_field "Choice catalog" "invalid"
        STATUS=1
    elif [ "${CHOICE_VALIDATION}" = "valid" ]; then
        print_field "Choice catalog" "valid"
    else
        print_field "Choice catalog" "${CHOICE_VALIDATION}"
        WARNINGS=$((WARNINGS + 1))
    fi

    case "${CHOICE_KERNEL}" in
        missing|unknown)
            print_field "Choice kernel ok" "no"
            STATUS=1
            ;;
        *)
            print_field "Choice kernel ok" "yes"
            ;;
    esac

    case "${CHOICE_ARTIFACT}" in
        missing|unknown)
            print_field "Choice artifact ok" "no"
            STATUS=1
            ;;
        /*)
            if [ -f "${TARGET_ROOT}${CHOICE_ARTIFACT}" ]; then
                print_field "Choice artifact ok" "present"
            else
                print_field "Choice artifact ok" "missing: ${CHOICE_ARTIFACT}"
                STATUS=1
            fi
            ;;
        *)
            print_field "Choice artifact ok" "not absolute"
            STATUS=1
            ;;
    esac

    case "${CHOICE_FRAGMENT}" in
        missing|unknown)
            print_field "Choice fragment ok" "no"
            STATUS=1
            ;;
        /*)
            if [ -f "${TARGET_ROOT}${CHOICE_FRAGMENT}" ]; then
                print_field "Choice fragment ok" "present"
            else
                print_field "Choice fragment ok" "missing: ${CHOICE_FRAGMENT}"
                STATUS=1
            fi
            ;;
        *)
            print_field "Choice fragment ok" "not absolute"
            STATUS=1
            ;;
    esac

    case "${CHOICE_INIT}" in
        missing|unknown)
            print_field "Choice init ok" "no"
            STATUS=1
            ;;
        *)
            print_field "Choice init ok" "yes"
            ;;
    esac

    case "${CHOICE_RDINIT}" in
        missing|unknown)
            print_field "Choice rdinit ok" "no"
            STATUS=1
            ;;
        *)
            print_field "Choice rdinit ok" "yes"
            if [ -e "${TARGET_ROOT}${CHOICE_RDINIT}" ]; then
                print_field "Choice init path" "present"
            else
                print_field "Choice init path" "missing: ${CHOICE_RDINIT}"
                STATUS=1
            fi
            case "${ENTRY_OPTIONS}" in
                *"rdinit=${CHOICE_RDINIT}"*) print_field "Choice rdinit match" "yes" ;;
                *) print_field "Choice rdinit match" "no"; STATUS=1 ;;
            esac
            ;;
    esac

    case "${CHOICE_INIT_FILES}" in
        missing|unknown)
            print_field "Choice init files ok" "no"
            STATUS=1
            ;;
        *)
            old_ifs="${IFS}"
            IFS=','
            set -- ${CHOICE_INIT_FILES}
            IFS="${old_ifs}"
            for init_file_path in "$@"; do
                [ -n "${init_file_path}" ] || continue
                case "${init_file_path}" in
                    /*)
                        if [ -f "${TARGET_ROOT}${init_file_path}" ]; then
                            print_field "Init file" "present: ${init_file_path}"
                        else
                            print_field "Init file" "missing: ${init_file_path}"
                            STATUS=1
                        fi
                        ;;
                    *)
                        print_field "Init file" "not absolute: ${init_file_path}"
                        STATUS=1
                        ;;
                esac
            done
            ;;
    esac

    case "${CHOICE_INIT_DIRS}" in
        missing|unknown)
            print_field "Choice init dirs ok" "no"
            STATUS=1
            ;;
        *)
            old_ifs="${IFS}"
            IFS=','
            set -- ${CHOICE_INIT_DIRS}
            IFS="${old_ifs}"
            for init_dir_path in "$@"; do
                [ -n "${init_dir_path}" ] || continue
                case "${init_dir_path}" in
                    /*)
                        if [ -d "${TARGET_ROOT}${init_dir_path}" ]; then
                            print_field "Init dir" "present: ${init_dir_path}"
                        else
                            print_field "Init dir" "missing: ${init_dir_path}"
                            STATUS=1
                        fi
                        ;;
                    *)
                        print_field "Init dir" "not absolute: ${init_dir_path}"
                        STATUS=1
                        ;;
                esac
            done
            ;;
    esac

    if [ "${CHOICE_DESKTOP}" != "none" ]; then
        if [ "${SELECTED_DESKTOP}" = "${CHOICE_DESKTOP}" ]; then
            print_field "Choice desktop match" "yes"
        else
            print_field "Choice desktop match" "no: ${SELECTED_DESKTOP}"
            STATUS=1
        fi
    else
        print_field "Choice desktop match" "none"
    fi

    if [ "${CHOICE_BUNDLES}" != "none" ]; then
        if [ ! -r "${PACKAGES_SELECTED_FILE}" ]; then
            print_field "Choice bundles match" "missing packages.selected"
            STATUS=1
        elif [ "${SELECTED_BUNDLES}" = "${CHOICE_BUNDLES}" ]; then
            print_field "Choice bundles match" "yes"
        else
            print_field "Choice bundles match" "no: ${SELECTED_BUNDLES}"
            STATUS=1
        fi
    else
        print_field "Choice bundles match" "none"
    fi

    if [ "${CHOICE_PACKAGES}" != "none" ]; then
        if [ ! -r "${PACKAGES_SELECTED_FILE}" ]; then
            print_field "Choice extra match" "missing packages.selected"
            STATUS=1
        elif [ "${SELECTED_EXTRA}" = "${CHOICE_PACKAGES}" ]; then
            print_field "Choice extra match" "yes"
        else
            print_field "Choice extra match" "no: ${SELECTED_EXTRA}"
            STATUS=1
        fi
    else
        print_field "Choice extra match" "none"
    fi
else
    print_field "System choice" "optional but recommended"
    WARNINGS=$((WARNINGS + 1))
fi

case "${ENTRY_OPTIONS}" in
    *"praxis.live=0"*) print_field "Entry live mode" "installed" ;;
    *) print_field "Entry live mode" "missing praxis.live=0"; STATUS=1 ;;
esac

if [ "${INSTALL_STAGE}" = "chroot" ]; then
    print_field "Chroot done" "yes"
else
    print_field "Chroot done" "no: run praxis-chroot first"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/fstab" ]; then
    print_field "fstab" "present"
    if grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/[[:space:]]+' "${TARGET_ROOT}/etc/fstab"; then
        print_field "fstab root" "UUID"
    else
        print_field "fstab root" "missing UUID"
        STATUS=1
    fi
    if grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/boot[[:space:]]+' "${TARGET_ROOT}/etc/fstab"; then
        print_field "fstab boot" "UUID"
    else
        print_field "fstab boot" "missing UUID"
        STATUS=1
    fi
else
    print_field "fstab" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/praxis/initramfs.conf" ]; then
    print_field "Initramfs conf" "present"
    if grep -Eq '^INITRAMFS_FORMAT=newc$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs format" "newc"
    else
        print_field "Initramfs format" "missing newc"
        STATUS=1
    fi
    if grep -Eq '^INITRAMFS_COMPRESSION=gzip$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs comp" "gzip"
    else
        print_field "Initramfs comp" "missing gzip"
        STATUS=1
    fi
    if grep -Eq '^INITRAMFS_OWNER=manual$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs owner" "manual"
    else
        print_field "Initramfs owner" "missing manual"
        STATUS=1
    fi
    INITRAMFS_ROOT="$(sed -n 's/^INITRAMFS_ROOT=//p' "${TARGET_ROOT}/etc/praxis/initramfs.conf" | sed -n '1p')"
    [ -n "${INITRAMFS_ROOT}" ] || INITRAMFS_ROOT="target"
    case "${INITRAMFS_ROOT}" in
        target|disk) print_field "Initramfs root" "${INITRAMFS_ROOT}" ;;
        *) print_field "Initramfs root" "invalid: ${INITRAMFS_ROOT}"; STATUS=1 ;;
    esac
else
    print_field "Initramfs conf" "missing"
    STATUS=1
fi

if [ -e "${TARGET_ROOT}/etc/localtime" ]; then
    print_field "localtime" "present"
else
    print_field "localtime" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/locale.conf" ]; then
    print_field "locale.conf" "present"
else
    print_field "locale.conf" "missing"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/machine-id" ] && grep -Eq '^[0-9a-f]{32}$' "${TARGET_ROOT}/etc/machine-id"; then
    print_field "machine-id" "present"
else
    print_field "machine-id" "missing/invalid"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/hostname" ]; then
    print_field "hostname" "present"
else
    print_field "hostname" "missing"
    STATUS=1
fi

if [ "${HOSTS_STATUS}" = "ok" ]; then
    print_field "hosts" "present"
elif [ "${HOSTS_STATUS}" = "present" ]; then
    print_field "hosts" "present"
    WARNINGS=$((WARNINGS + 1))
else
    print_field "hosts" "missing"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/praxis/install" ]; then
    print_field "Install meta" "present"
else
    print_field "Install meta" "missing"
    WARNINGS=$((WARNINGS + 1))
fi

if [ -f "${TARGET_ROOT}/boot/praxis/README.txt" ]; then
    print_field "Boot README" "present"
else
    print_field "Boot README" "optional"
fi

if [ -f "${TARGET_ROOT}/boot/praxis/limine.conf" ]; then
    print_field "Praxis Limine" "present"
else
    print_field "Praxis Limine" "missing"
    WARNINGS=$((WARNINGS + 1))
fi

if [ -f "${TARGET_ROOT}/boot/limine.conf" ]; then
    print_field "Boot Limine" "present"
else
    print_field "Boot Limine" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/boot/EFI/BOOT/BOOTX64.EFI" ] || [ -f "${TARGET_ROOT}/boot/EFI/systemd/systemd-bootx64.efi" ]; then
    print_field "Bootloader EFI" "present"
else
    print_field "Bootloader EFI" "missing"
    STATUS=1
fi

if [ "${STRICT_MODE}" = "1" ]; then
    if [ "${CHOICE_STATUS}" = "present" ]; then
        print_field "Strict choice" "present"
    else
        print_field "Strict choice" "missing"
        STATUS=1
    fi

    if [ -r "${TARGET_ROOT}/etc/praxis/build-info" ]; then
        print_field "Strict build-info" "present"
    else
        print_field "Strict build-info" "missing"
        STATUS=1
    fi

    if [ -r "${TARGET_ROOT}/etc/praxis/rootfs.sha256" ]; then
        print_field "Strict rootfs sha" "present"
    else
        print_field "Strict rootfs sha" "missing"
        STATUS=1
    fi

    if [ -x "${SCRIPT_DIR}/praxis-provenance" ]; then
        if PRAXIS_LIB_ROOT="${PRAXIS_LIB_ROOT:-${SCRIPT_DIR}/lib}" "${SCRIPT_DIR}/praxis-provenance" verify "${TARGET_ROOT}" >/dev/null 2>&1; then
            print_field "Strict provenance" "valid"
        else
            print_field "Strict provenance" "invalid"
            STATUS=1
        fi
    else
        print_field "Strict provenance" "unchecked"
        STATUS=1
    fi

    if [ -x "${SCRIPT_DIR}/praxis-manifest" ]; then
        if PRAXIS_LIB_ROOT="${PRAXIS_LIB_ROOT:-${SCRIPT_DIR}/lib}" PRAXIS_CONFIG_ROOT="${TARGET_ROOT}/etc/praxis" "${SCRIPT_DIR}/praxis-manifest" verify base-system "${TARGET_ROOT}" >/dev/null 2>&1; then
            print_field "Strict manifest" "valid"
        else
            print_field "Strict manifest" "invalid"
            STATUS=1
        fi
    else
        print_field "Strict manifest" "unchecked"
        STATUS=1
    fi

    if [ -r "${PACKAGES_SELECTED_FILE}" ]; then
        print_field "Strict packages" "present"
    else
        print_field "Strict packages" "missing"
        STATUS=1
    fi

    if [ "${WARNINGS}" = "0" ]; then
        print_field "Strict warnings" "none"
    else
        print_field "Strict warnings" "${WARNINGS}"
        STATUS=1
    fi
fi

printf '\n'

if [ "${STATUS}" = "0" ]; then
    exit 0
fi

exit 1
