#!/bin/sh

set -eu

case "$0" in
    */*)
        SCRIPT_DIR_PATH="${0%/*}"
        ;;
    *)
        SCRIPT_DIR_PATH="."
        ;;
esac

SCRIPT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR_PATH}" && pwd)"

if [ -n "${PRAXIS_LIB_ROOT:-}" ] && [ -r "${PRAXIS_LIB_ROOT}/common.sh" ]; then
    . "${PRAXIS_LIB_ROOT}/common.sh"
elif [ -r /usr/local/lib/praxis/common.sh ]; then
    . /usr/local/lib/praxis/common.sh
else
    . "${SCRIPT_DIR}/lib/common.sh"
fi

TARGET_ROOT="${1:-}"

usage() {
    printf '%s\n' "usage: praxis-target-check <target-root>"
    printf '%s\n' "example: praxis-target-check /mnt/praxis"
}

print_field() {
    printf '%-18s %s\n' "$1" "$2"
}

read_meta_value() {
    META_FILE="$1"
    META_KEY="$2"

    if [ ! -r "${META_FILE}" ]; then
        return 1
    fi

    sed -n "s/^${META_KEY}=//p" "${META_FILE}" | sed -n '1p'
}

if [ -z "${TARGET_ROOT}" ]; then
    usage >&2
    exit 1
fi

if [ ! -d "${TARGET_ROOT}" ]; then
    printf 'missing target root: %s\n' "${TARGET_ROOT}" >&2
    exit 1
fi

ROOT_MOUNTED="no"
BOOT_MOUNTED="no"
ROOT_FSTYPE="unknown"
BOOT_FSTYPE="unknown"
ESP_STATUS="unknown"
INSTALL_MODE="missing"
INSTALL_ENTRY="unknown"
SYSTEMD_BOOT_ENTRY="unknown"
SYSTEMD_BOOT_INSTALLED="unknown"
LIMINE_CONFIG="unknown"
LIMINE_UEFI="unknown"
INSTALL_COMPLETE="unknown"
INSTALL_STAGE="none"
TARGET_HOSTNAME="unknown"
INSTALL_DESKTOP="none"
INSTALL_BUNDLES="none"
INSTALL_PACKAGES="none"
HOSTS_STATUS="missing"
ENTRY_FILE=""
EXPECTED_ENTRY_FILE=""
LOADER_CONF_FILE="${TARGET_ROOT}/boot/loader/loader.conf"
LOADER_DEFAULT="unknown"
ENTRY_LINUX="unknown"
ENTRY_INITRD="unknown"
ENTRY_OPTIONS="unknown"
FSTAB_ROOT_UUID="unknown"
FSTAB_BOOT_UUID="unknown"
ENTRY_ROOT_UUID="unknown"
STATUS=0
WARNINGS=0
PARTIAL_INSTALL=0

if praxis_is_mountpoint "${TARGET_ROOT}"; then
    ROOT_MOUNTED="yes"
    ROOT_FSTYPE="$(praxis_find_mount_fstype "${TARGET_ROOT}" || true)"
fi

if praxis_is_mountpoint "${TARGET_ROOT}/boot"; then
    BOOT_MOUNTED="yes"
    BOOT_FSTYPE="$(praxis_find_mount_fstype "${TARGET_ROOT}/boot" || true)"
fi

[ -n "${ROOT_FSTYPE}" ] || ROOT_FSTYPE="unknown"
[ -n "${BOOT_FSTYPE}" ] || BOOT_FSTYPE="unknown"

case "${BOOT_FSTYPE}" in
    vfat|fat|fat32|msdos)
        ESP_STATUS="likely"
        ;;
    unknown)
        ESP_STATUS="unknown"
        ;;
    *)
        ESP_STATUS="unlikely"
        ;;
esac

for CANDIDATE in "${TARGET_ROOT}/boot/loader/entries/"*.conf; do
    if [ -f "${CANDIDATE}" ]; then
        ENTRY_FILE="${CANDIDATE}"
        break
    fi
done

if [ -r "${TARGET_ROOT}/etc/praxis/install-stage" ]; then
    INSTALL_STAGE="$(head -n1 "${TARGET_ROOT}/etc/praxis/install-stage" 2>/dev/null || true)"
    [ -n "${INSTALL_STAGE}" ] || INSTALL_STAGE="none"
fi

if [ -r "${TARGET_ROOT}/etc/praxis/install" ]; then
    INSTALL_MODE="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_MODE || true)"
    [ -n "${INSTALL_MODE}" ] || INSTALL_MODE="present"
    TARGET_HOSTNAME="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_HOSTNAME || true)"
    [ -n "${TARGET_HOSTNAME}" ] || TARGET_HOSTNAME="unknown"
    INSTALL_ENTRY="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_ENTRY || true)"
    [ -n "${INSTALL_ENTRY}" ] || INSTALL_ENTRY="unknown"
    INSTALL_DESKTOP="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_DESKTOP || true)"
    [ -n "${INSTALL_DESKTOP}" ] || INSTALL_DESKTOP="none"
    INSTALL_BUNDLES="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_BUNDLES || true)"
    [ -n "${INSTALL_BUNDLES}" ] || INSTALL_BUNDLES="none"
    INSTALL_PACKAGES="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_PACKAGES || true)"
    [ -n "${INSTALL_PACKAGES}" ] || INSTALL_PACKAGES="none"
    SYSTEMD_BOOT_ENTRY="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" SYSTEMD_BOOT_ENTRY || true)"
    [ -n "${SYSTEMD_BOOT_ENTRY}" ] || SYSTEMD_BOOT_ENTRY="unknown"
    SYSTEMD_BOOT_INSTALLED="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" SYSTEMD_BOOT_INSTALLED || true)"
    [ -n "${SYSTEMD_BOOT_INSTALLED}" ] || SYSTEMD_BOOT_INSTALLED="unknown"
    LIMINE_CONFIG="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" LIMINE_CONFIG || true)"
    [ -n "${LIMINE_CONFIG}" ] || LIMINE_CONFIG="unknown"
    LIMINE_UEFI="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" LIMINE_UEFI || true)"
    [ -n "${LIMINE_UEFI}" ] || LIMINE_UEFI="unknown"
    INSTALL_COMPLETE="$(read_meta_value "${TARGET_ROOT}/etc/praxis/install" INSTALL_COMPLETE || true)"
    [ -n "${INSTALL_COMPLETE}" ] || INSTALL_COMPLETE="unknown"
fi

if [ ! -r "${TARGET_ROOT}/etc/praxis/install" ] && { [ -f "${TARGET_ROOT}/boot/praxis/vmlinuz" ] || [ -f "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz" ]; }; then
    PARTIAL_INSTALL=1
fi

if [ "${INSTALL_ENTRY}" != "unknown" ]; then
    EXPECTED_ENTRY_FILE="${TARGET_ROOT}/boot/loader/entries/${INSTALL_ENTRY}.conf"
    if [ -f "${EXPECTED_ENTRY_FILE}" ]; then
        ENTRY_FILE="${EXPECTED_ENTRY_FILE}"
    fi
fi

if [ -f "${LOADER_CONF_FILE}" ]; then
    LOADER_DEFAULT="$(sed -n 's/^default[[:space:]]\+//p' "${LOADER_CONF_FILE}" | sed -n '1p')"
    [ -n "${LOADER_DEFAULT}" ] || LOADER_DEFAULT="unknown"
fi

if [ -n "${ENTRY_FILE}" ] && [ -r "${ENTRY_FILE}" ]; then
    ENTRY_LINUX="$(sed -n 's/^linux[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_LINUX}" ] || ENTRY_LINUX="unknown"
    ENTRY_INITRD="$(sed -n 's/^initrd[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_INITRD}" ] || ENTRY_INITRD="unknown"
    ENTRY_OPTIONS="$(sed -n 's/^options[[:space:]]\+//p' "${ENTRY_FILE}" | sed -n '1p')"
    [ -n "${ENTRY_OPTIONS}" ] || ENTRY_OPTIONS="unknown"
fi

if [ -r "${TARGET_ROOT}/etc/fstab" ]; then
    FSTAB_ROOT_UUID="$(sed -n 's/^[[:space:]]*UUID=\([^[:space:]]*\)[[:space:]]\+\/[[:space:]].*/\1/p' "${TARGET_ROOT}/etc/fstab" | sed -n '1p')"
    [ -n "${FSTAB_ROOT_UUID}" ] || FSTAB_ROOT_UUID="unknown"
    FSTAB_BOOT_UUID="$(sed -n 's/^[[:space:]]*UUID=\([^[:space:]]*\)[[:space:]]\+\/boot[[:space:]].*/\1/p' "${TARGET_ROOT}/etc/fstab" | sed -n '1p')"
    [ -n "${FSTAB_BOOT_UUID}" ] || FSTAB_BOOT_UUID="unknown"
fi

case "${ENTRY_OPTIONS}" in
    *root=UUID=*)
        ENTRY_ROOT_UUID="$(printf '%s\n' "${ENTRY_OPTIONS}" | sed -n 's/.*root=UUID=\([^[:space:]]*\).*/\1/p')"
        [ -n "${ENTRY_ROOT_UUID}" ] || ENTRY_ROOT_UUID="unknown"
        ;;
esac

if [ "${TARGET_HOSTNAME}" = "unknown" ] && [ -r "${TARGET_ROOT}/etc/hostname" ]; then
    TARGET_HOSTNAME="$(sed -n '1p' "${TARGET_ROOT}/etc/hostname")"
    [ -n "${TARGET_HOSTNAME}" ] || TARGET_HOSTNAME="unknown"
fi

if [ -r "${TARGET_ROOT}/etc/hosts" ] && [ "${TARGET_HOSTNAME}" != "unknown" ]; then
    if grep -Eq "^127\\.0\\.1\\.1[[:space:]]+${TARGET_HOSTNAME}\$" "${TARGET_ROOT}/etc/hosts"; then
        HOSTS_STATUS="ok"
    else
        HOSTS_STATUS="present"
    fi
fi

praxis_header "targetcheck"
print_field "Target" "${TARGET_ROOT}"
print_field "Root mounted" "${ROOT_MOUNTED}"
print_field "Boot mounted" "${BOOT_MOUNTED}"
print_field "Root fs" "${ROOT_FSTYPE}"
print_field "Boot fs" "${BOOT_FSTYPE}"
print_field "Boot is ESP" "${ESP_STATUS}"
print_field "Install mode" "${INSTALL_MODE}"
print_field "Install stage" "${INSTALL_STAGE}"
print_field "Hostname" "${TARGET_HOSTNAME}"
print_field "Install entry" "${INSTALL_ENTRY}"
print_field "Loader default" "${LOADER_DEFAULT}"
print_field "Bootctl entry" "${SYSTEMD_BOOT_ENTRY}"
print_field "Bootctl installed" "${SYSTEMD_BOOT_INSTALLED}"
print_field "Limine config" "${LIMINE_CONFIG}"
print_field "Limine UEFI" "${LIMINE_UEFI}"
print_field "Install complete" "${INSTALL_COMPLETE}"

if [ -f "${TARGET_ROOT}/boot/praxis/vmlinuz" ]; then
    print_field "Kernel" "present"
else
    print_field "Kernel" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/boot/praxis/initramfs.cpio.gz" ]; then
    print_field "Initramfs" "present"
else
    print_field "Initramfs" "missing"
    STATUS=1
fi

if [ -n "${ENTRY_FILE}" ]; then
    print_field "Loader entry" "${ENTRY_FILE##*/}"
else
    print_field "Loader entry" "missing"
    STATUS=1
fi

if [ -f "${LOADER_CONF_FILE}" ]; then
    print_field "loader.conf" "present"
else
    print_field "loader.conf" "missing"
    STATUS=1
fi

if [ -n "${ENTRY_FILE}" ]; then
    ENTRY_NAME="${ENTRY_FILE##*/}"
    ENTRY_NAME="${ENTRY_NAME%.conf}"
    if [ "${LOADER_DEFAULT}" = "${ENTRY_NAME}" ]; then
        print_field "Default matches" "yes"
    else
        print_field "Default matches" "no: ${LOADER_DEFAULT}"
        STATUS=1
    fi
fi

if [ "${ENTRY_LINUX}" = "/praxis/vmlinuz" ]; then
    print_field "Entry linux" "${ENTRY_LINUX}"
elif [ -n "${ENTRY_FILE}" ]; then
    print_field "Entry linux" "${ENTRY_LINUX}"
    STATUS=1
fi

if [ "${ENTRY_INITRD}" = "/praxis/initramfs.cpio.gz" ]; then
    print_field "Entry initrd" "${ENTRY_INITRD}"
elif [ -n "${ENTRY_FILE}" ]; then
    print_field "Entry initrd" "${ENTRY_INITRD}"
    STATUS=1
fi

case "${ENTRY_OPTIONS}" in
    *"root=UUID="*) print_field "Entry root" "UUID" ;;
    *) print_field "Entry root" "missing root=UUID"; STATUS=1 ;;
esac

if [ "${FSTAB_ROOT_UUID}" != "unknown" ] && [ "${ENTRY_ROOT_UUID}" = "${FSTAB_ROOT_UUID}" ]; then
    print_field "Root UUID match" "yes"
else
    print_field "Root UUID match" "no"
    STATUS=1
fi

case "${ENTRY_OPTIONS}" in
    *"rdinit=/init"*) print_field "Entry rdinit" "present" ;;
    *) print_field "Entry rdinit" "missing"; STATUS=1 ;;
esac

case "${ENTRY_OPTIONS}" in
    *"praxis.live=0"*) print_field "Entry live mode" "installed" ;;
    *) print_field "Entry live mode" "missing praxis.live=0"; STATUS=1 ;;
esac

if [ "${INSTALL_STAGE}" = "chroot" ]; then
    print_field "Chroot done" "yes"
else
    print_field "Chroot done" "no: run praxis-chroot first"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/fstab" ]; then
    print_field "fstab" "present"
    if grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/[[:space:]]+' "${TARGET_ROOT}/etc/fstab"; then
        print_field "fstab root" "UUID"
    else
        print_field "fstab root" "missing UUID"
        STATUS=1
    fi
    if grep -Eq '^[[:space:]]*UUID=[^[:space:]]+[[:space:]]+/boot[[:space:]]+' "${TARGET_ROOT}/etc/fstab"; then
        print_field "fstab boot" "UUID"
    else
        print_field "fstab boot" "missing UUID"
        STATUS=1
    fi
else
    print_field "fstab" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/praxis/initramfs.conf" ]; then
    print_field "Initramfs conf" "present"
    if grep -Eq '^INITRAMFS_FORMAT=newc$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs format" "newc"
    else
        print_field "Initramfs format" "missing newc"
        STATUS=1
    fi
    if grep -Eq '^INITRAMFS_COMPRESSION=gzip$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs comp" "gzip"
    else
        print_field "Initramfs comp" "missing gzip"
        STATUS=1
    fi
    if grep -Eq '^INITRAMFS_OWNER=manual$' "${TARGET_ROOT}/etc/praxis/initramfs.conf"; then
        print_field "Initramfs owner" "manual"
    else
        print_field "Initramfs owner" "missing manual"
        STATUS=1
    fi
    INITRAMFS_ROOT="$(sed -n 's/^INITRAMFS_ROOT=//p' "${TARGET_ROOT}/etc/praxis/initramfs.conf" | sed -n '1p')"
    [ -n "${INITRAMFS_ROOT}" ] || INITRAMFS_ROOT="target"
    case "${INITRAMFS_ROOT}" in
        target|disk) print_field "Initramfs root" "${INITRAMFS_ROOT}" ;;
        *) print_field "Initramfs root" "invalid: ${INITRAMFS_ROOT}"; STATUS=1 ;;
    esac
else
    print_field "Initramfs conf" "missing"
    STATUS=1
fi

if [ -e "${TARGET_ROOT}/etc/localtime" ]; then
    print_field "localtime" "present"
else
    print_field "localtime" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/etc/locale.conf" ]; then
    print_field "locale.conf" "present"
else
    print_field "locale.conf" "missing"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/machine-id" ] && grep -Eq '^[0-9a-f]{32}$' "${TARGET_ROOT}/etc/machine-id"; then
    print_field "machine-id" "present"
else
    print_field "machine-id" "missing/invalid"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/hostname" ]; then
    print_field "hostname" "present"
else
    print_field "hostname" "missing"
    STATUS=1
fi

if [ "${HOSTS_STATUS}" = "ok" ]; then
    print_field "hosts" "present"
elif [ "${HOSTS_STATUS}" = "present" ]; then
    print_field "hosts" "present"
    WARNINGS=$((WARNINGS + 1))
else
    print_field "hosts" "missing"
    STATUS=1
fi

if [ -r "${TARGET_ROOT}/etc/praxis/install" ]; then
    print_field "Install meta" "present"
else
    print_field "Install meta" "missing"
    WARNINGS=$((WARNINGS + 1))
fi

if [ -f "${TARGET_ROOT}/boot/praxis/README.txt" ]; then
    print_field "Boot README" "present"
else
    print_field "Boot README" "optional"
fi

if [ -f "${TARGET_ROOT}/boot/praxis/limine.conf" ]; then
    print_field "Praxis Limine" "present"
else
    print_field "Praxis Limine" "missing"
    WARNINGS=$((WARNINGS + 1))
fi

if [ -f "${TARGET_ROOT}/boot/limine.conf" ]; then
    print_field "Boot Limine" "present"
else
    print_field "Boot Limine" "missing"
    STATUS=1
fi

if [ -f "${TARGET_ROOT}/boot/EFI/BOOT/BOOTX64.EFI" ] || [ -f "${TARGET_ROOT}/boot/EFI/systemd/systemd-bootx64.efi" ]; then
    print_field "Bootloader EFI" "present"
else
    print_field "Bootloader EFI" "missing"
    STATUS=1
fi

printf '\n'

if [ "${STATUS}" = "0" ]; then
    exit 0
fi

exit 1
